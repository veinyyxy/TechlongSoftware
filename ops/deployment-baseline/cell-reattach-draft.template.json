            "Key": "Environment",
            "Value": "aws-sandbox"
          },
          {
            "Key": "ManagedBy",
            "Value": "techlong-provisioner"
          },
          {
            "Key": "CellId",
            "Value": "cell-sandbox-1"
          },
          {
            "Key": "ExpiresAt",
