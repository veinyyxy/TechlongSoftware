          {
            "FixedResponseConfig": {
              "ContentType": "application/json",
              "MessageBody": "{\"success\":false,\"code\":\"NOT_FOUND\"}",
              "StatusCode": "404"
            },
            "Type": "fixed-response"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "CellLoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
