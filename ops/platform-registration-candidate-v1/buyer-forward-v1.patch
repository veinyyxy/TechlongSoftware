index 0000000000000000000000000000000000000000..fdda1da435c02666239f22514ff53223dd2e999e
--- /dev/null
+++ b/lib/buyer-forward/signer-binding.ts
@@ -0,0 +1,20 @@
+import { firstOpenBuyerWire, hasFirstOpenBuyerSigningMaterial } from "./wire.mjs";
+
+export const firstOpenBuyerSignerEnvName = firstOpenBuyerWire.signerEnvName;
+export const firstOpenBuyerSignerSecretName = "techlong/sandbox/platform-web/buyer-forward/fc41597f-hmac-v1";
+const arnPrefix = `arn:aws:secretsmanager:ca-central-1:402010193138:secret:${firstOpenBuyerSignerSecretName}-`;
+
+export type FirstOpenBuyerSignerPin = Readonly<{ arn: string; versionId: string }>;
+
+export function isFirstOpenBuyerSignerPin(value: unknown): value is FirstOpenBuyerSignerPin {
+  if (!value || typeof value !== "object" || Object.keys(value).sort().join(",") !== "arn,versionId") return false;
+  const { arn, versionId } = value as Partial<FirstOpenBuyerSignerPin>;
+  return typeof arn === "string" && arn.startsWith(arnPrefix) && /^[A-Za-z0-9]{6}$/.test(arn.slice(arnPrefix.length)) &&
+    typeof versionId === "string" && /^[A-Za-z0-9-]{32,64}$/.test(versionId);
+}
+
+// Canonical base64url encoding of exactly 32 fresh random bytes, raw text.
+// Do not normalize/truncate, accept placeholders or parse a runtime JSON.
+export function isFirstOpenBuyerSigningKey(value: unknown): value is string {
+  return hasFirstOpenBuyerSigningMaterial(value);
+}
diff --git a/lib/buyer-forward/wire.mjs b/lib/buyer-forward/wire.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7eb6fd35cdbb55cf6e7d49742eb3a4f4e9eb8e99
--- /dev/null
+++ b/lib/buyer-forward/wire.mjs
@@ -0,0 +1,15 @@
+// Public constants, also loaded directly by the minimal Node hosting entry.
+const tenantId = "app_bbd626d7d3806af686073211";
+export const firstOpenBuyerWire = Object.freeze({
+  tenantId,
+  buyerOrigin: `https://${tenantId.replace("_", "-")}.sandbox.techlong.cloud`,
+  consoleOrigin: "https://console.sandbox.techlong.cloud",
+  prefix: "/api/buyer-forward",
+  signerEnvName: "FIRST_OPEN_BUYER_FORWARD_HMAC",
+});
+
+// 32 bytes form 42 complete Base64 characters and four remaining bits.
+// Require canonical zero padding bits; never write the value into policy state.
+export function hasFirstOpenBuyerSigningMaterial(value) {
+  return typeof value === "string" && /^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$/.test(value);
+}
diff --git a/lib/deployments/execution/first-open-buyer-binding.ts b/lib/deployments/execution/first-open-buyer-binding.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04e96a50f2844ac32050c7dad8809d6b032ae3f8
--- /dev/null
+++ b/lib/deployments/execution/first-open-buyer-binding.ts
@@ -0,0 +1,42 @@
+import { firstOpenBuyerWire } from "../../buyer-forward/wire.mjs";
+
+/** Public data only. The existing Sandbox beta buyer alias is not a tenant ID. */
+export const sandboxBuyerRuntimePath = "/buyer-runtime.json";
+export const sandboxBuyerPaymentPaths = Object.freeze({ success: "/payment-success", cancel: "/payment-cancel" });
+const sandboxSuffix = ".sandbox.techlong.cloud";
+const instanceIdPattern = /^app_[a-f0-9]{24}$/;
+
+export function bindSandboxBuyerOrigin(tenantId: string) {
+  if (!instanceIdPattern.test(tenantId)) throw Error("SANDBOX_BUYER_TENANT_ID_INVALID");
+  // Prefix and full ID suffix are preserved: no truncation or case folding.
+  const tenantLabel = tenantId.replace("_", "-");
+  const buyerHostname = tenantLabel + sandboxSuffix;
+  const apiHostname = `pending-${tenantLabel}${sandboxSuffix}`;
+  return Object.freeze({ tenantId, buyerHostname, apiHostname,
+    buyerOrigin: `https://${buyerHostname}`, apiOrigin: `https://${apiHostname}` });
+}
+
+const binding = bindSandboxBuyerOrigin(firstOpenBuyerWire.tenantId);
+export const firstOpenBuyerBinding = Object.freeze({ ...binding, parameters: Object.freeze({
+  ControlIssuer: "https://techlong.cloud",
+  CorsAllowedOrigins: binding.buyerOrigin,
+  // Stripe redirection is not a payment verdict. Neither landing needs a
+  // Checkout Session ID or any other Stripe data in the address or page.
+  StripeSuccessUrl: `${binding.buyerOrigin}${sandboxBuyerPaymentPaths.success}`,
+  StripeCancelUrl: `${binding.buyerOrigin}${sandboxBuyerPaymentPaths.cancel}`,
+}) });
+
+/** Complete the offline scope before sealing it; never silently rewrite a
+ * previously specified origin or redirect from a different tenant. */
+export function completeFirstOpenBuyerParameters(base: Readonly<Record<string, string>>) {
+  for (const [key, value] of Object.entries(firstOpenBuyerBinding.parameters)) {
+    if (Object.hasOwn(base, key) && base[key] !== value) throw Error("FIRST_OPEN_BUYER_PARAMETERS_CHANGED");
+  }
+  return { ...base, ...firstOpenBuyerBinding.parameters };
+}
+
+export function assertFirstOpenBuyerParameters(parameters: Readonly<Record<string, string>>) {
+  if (Object.entries(firstOpenBuyerBinding.parameters).some(([name, value]) => parameters[name] !== value)) {
+    throw Error("FIRST_OPEN_BUYER_PARAMETERS_CHANGED");
+  }
+}
