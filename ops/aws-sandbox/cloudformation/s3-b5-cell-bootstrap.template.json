{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "B5-J4b cleanup-only Shared Cell inventory bootstrap. It creates no Cell apply role and cannot create or delete a Shared Cell.",
  "Metadata": {
    "SafetyBoundary": {
      "CloudApplyEnabled": true,
      "CreatesSharedCell": false,
      "CreatesPaidCellResources": false,
      "CreatesBootstrapRuntimeResources": true,
      "MayIncurAwsCharges": true,
      "CellApplyRolesPresent": false,
      "CellCreateChangeSetAllowed": false,
      "CellExecuteChangeSetAllowed": false,
      "CellExecutionPassRoleAllowed": false,
      "CellDeletionAllowed": false,
      "JanitorScheduleEnabled": false,
      "RequiresDedicatedManagementStack": true,
      "ApprovedManagementStackName": "techlong-s3-b5-cell-bootstrap-management",
      "ApprovedCellStackName": "techlong-sandbox-cell-sandbox-1"
    }
  },
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "402010193138",
      "AllowedValues": ["402010193138"]
    },
    "ExpectedRegion": {
      "Type": "String",
      "Default": "ca-central-1",
      "AllowedValues": ["ca-central-1"]
    }
  },
  "Conditions": {
    "IsExpectedAccount": {
      "Fn::Equals": [{ "Ref": "AWS::AccountId" }, { "Ref": "ExpectedAccountId" }]
    },
    "IsExpectedRegion": {
      "Fn::Equals": [{ "Ref": "AWS::Region" }, { "Ref": "ExpectedRegion" }]
    },
    "IsExpectedTarget": {
      "Fn::And": [
        { "Condition": "IsExpectedAccount" },
        { "Condition": "IsExpectedRegion" }
      ]
    }
  },
  "Resources": {
    "CellJanitorLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "IsExpectedTarget",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "LogGroupName": "/aws/lambda/techlong-sandbox-cell-janitor",
        "LogGroupClass": "STANDARD",
        "RetentionInDays": 1,
        "Tags": [
          { "Key": "Environment", "Value": "aws-sandbox" },
          { "Key": "ManagedBy", "Value": "techlong-cell-bootstrap-manager" },
          { "Key": "Component", "Value": "cell-janitor" }
        ]
      }
    },
    "CellJanitorFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "IsExpectedTarget",
      "DependsOn": ["CellJanitorLogGroup"],
      "Properties": {
        "FunctionName": "techlong-sandbox-cell-janitor",
        "Description": "Locked B5-J4b read-only inventory probe for the approved Sandbox Shared Cell name.",
        "Runtime": "nodejs22.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "MemorySize": 128,
        "Timeout": 60,
        "ReservedConcurrentExecutions": 1,
        "Role": "arn:aws:iam::402010193138:role/TechlongSandboxCellJanitorExecutionRole",
        "Code": { "ZipFile": "__CELL_JANITOR_INLINE_SOURCE__" },
        "Environment": {
          "Variables": {
            "EXPECTED_ACCOUNT_ID": "402010193138",
            "EXPECTED_REGION": "ca-central-1",
            "EXPECTED_CELL_ID": "cell-sandbox-1",
            "CELL_MUTATION_ENABLED": "false"
          }
        },
        "Tags": [
          { "Key": "Environment", "Value": "aws-sandbox" },
          { "Key": "ManagedBy", "Value": "techlong-cell-bootstrap-manager" },
          { "Key": "Component", "Value": "cell-janitor" }
        ]
      }
    },
    "CellSchedulerGroup": {
      "Type": "AWS::Scheduler::ScheduleGroup",
      "Condition": "IsExpectedTarget",
      "Properties": {
        "Name": "techlong-sandbox-cell",
        "Tags": [
          { "Key": "Environment", "Value": "aws-sandbox" },
          { "Key": "ManagedBy", "Value": "techlong-cell-bootstrap-manager" },
          { "Key": "Component", "Value": "cell-scheduler" }
        ]
      }
    },
    "CellGlobalJanitorSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Condition": "IsExpectedTarget",
      "DependsOn": ["CellJanitorFunction", "CellSchedulerGroup"],
      "Properties": {
        "Name": "techlong-sandbox-cell-global-janitor",
        "GroupName": { "Ref": "CellSchedulerGroup" },
        "Description": "Disabled B5-J4b read-only inventory probe; Cell cleanup is not armed.",
        "FlexibleTimeWindow": { "Mode": "OFF" },
        "ScheduleExpression": "rate(15 minutes)",
        "State": "DISABLED",
        "Target": {
          "Arn": { "Fn::GetAtt": ["CellJanitorFunction", "Arn"] },
          "RoleArn": "arn:aws:iam::402010193138:role/TechlongSandboxCellSchedulerInvokeRole",
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 3600,
            "MaximumRetryAttempts": 0
          },
          "Input": "{\"schemaVersion\":1,\"action\":\"inspect_empty_shared_cell_inventory\"}"
        }
      }
    }
  },
  "Outputs": {
    "CellJanitorFunctionArn": {
      "Condition": "IsExpectedTarget",
      "Value": { "Fn::GetAtt": ["CellJanitorFunction", "Arn"] }
    },
    "CellSchedulerInvokeRoleArn": {
      "Condition": "IsExpectedTarget",
      "Value": "arn:aws:iam::402010193138:role/TechlongSandboxCellSchedulerInvokeRole"
    },
    "CellSchedulerGroupName": {
      "Condition": "IsExpectedTarget",
      "Value": { "Ref": "CellSchedulerGroup" }
    },
    "ApprovedCellStackName": {
      "Condition": "IsExpectedTarget",
      "Value": "techlong-sandbox-cell-sandbox-1"
    },
    "SafetyState": {
      "Condition": "IsExpectedTarget",
      "Value": "B5_J4B_EMPTY_SCAN_ONLY_CELL_APPLY_AND_DELETE_DISABLED"
    }
  }
}
