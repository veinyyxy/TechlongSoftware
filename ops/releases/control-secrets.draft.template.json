{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PREPARATION ONLY - three control DB Secrets, no runtime/IAM/compute. Separate exact approval required.",
  "Metadata": {
    "PreparationOnly": true,
    "TargetAccount": "402010193138",
    "TargetRegion": "ca-central-1",
    "TargetStackName": "techlong-sandbox-instance-release-secrets-v1",
    "CredentialValuesMustNotEnterRepository": true
  },
  "Parameters": {
    "PlannerSecretJson": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "MaxLength": 4096,
      "Description": "JSON with only connectionString for deployment_release_planner_login; supplied in memory only after approval; no owner credentials."
    },
    "ExecutorSecretJson": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "MaxLength": 4096,
      "Description": "JSON with only connectionString for deployment_release_executor_login; supplied in memory only after approval; no owner credentials."
    },
    "VerifierSecretJson": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "MaxLength": 4096,
      "Description": "JSON with only connectionString for deployment_release_verifier_login; supplied in memory only after approval; no owner credentials."
    }
  },
  "Resources": {
    "PlannerSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "techlong/sandbox/instance-release/planner-db-v1",
        "Description": "Dedicated planner Neon LOGIN; fixed VersionId required before runtime activation.",
        "SecretString": {
          "Ref": "PlannerSecretJson"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Techlong"
          },
          {
            "Key": "Environment",
            "Value": "sandbox"
          },
          {
            "Key": "Purpose",
            "Value": "instance-release"
          }
        ]
      }
    },
    "ExecutorSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "techlong/sandbox/instance-release/executor-db-v1",
        "Description": "Dedicated executor Neon LOGIN; fixed VersionId required before runtime activation.",
        "SecretString": {
          "Ref": "ExecutorSecretJson"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Techlong"
          },
          {
            "Key": "Environment",
            "Value": "sandbox"
          },
          {
            "Key": "Purpose",
            "Value": "instance-release"
          }
        ]
      }
    },
    "VerifierSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "techlong/sandbox/instance-release/verifier-db-v1",
        "Description": "Dedicated verifier Neon LOGIN; fixed VersionId required before runtime activation.",
        "SecretString": {
          "Ref": "VerifierSecretJson"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Techlong"
          },
          {
            "Key": "Environment",
            "Value": "sandbox"
          },
          {
            "Key": "Purpose",
            "Value": "instance-release"
          }
        ]
      }
    }
  },
  "Outputs": {
    "PlannerSecretArn": {
      "Value": {
        "Ref": "PlannerSecret"
      }
    },
    "ExecutorSecretArn": {
      "Value": {
        "Ref": "ExecutorSecret"
      }
    },
    "VerifierSecretArn": {
      "Value": {
        "Ref": "VerifierSecret"
      }
    }
  }
}
