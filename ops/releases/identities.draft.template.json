            {
              "Sid": "ListClusterTasks",
              "Effect": "Allow",
              "Action": [
                "ecs:ListTasks"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ca-central-1"
                },
                "ArnEquals": {
                  "ecs:cluster": {
                    "Ref": "EcsClusterArn"
                  }
                }
              }
            },
            {
              "Sid": "ReadClusterTasks",
              "Effect": "Allow",
              "Action": [
                "ecs:DescribeTasks"
              ],
              "Resource": {
                "Ref": "EcsTaskArnPattern"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ca-central-1"
                },
                "ArnEquals": {
                  "ecs:cluster": {
                    "Ref": "EcsClusterArn"
