                  "aws:RequestedRegion": "ca-central-1"
                }
              }
            },
            {
              "Sid": "ReadApiDns",
              "Effect": "Allow",
              "Action": [
                "route53:ListResourceRecordSets"
              ],
              "Resource": {
                "Ref": "HostedZoneArns"
              }
            },
            {
              "Sid": "HeadUploadBucketsAlsoAllowsListingKeys",
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket"
              ],
              "Resource": {
                "Ref": "UploadBucketArns"
              }
            },
            {
              "Sid": "OwnFixedControlSecret",
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": {
                "Ref": "PlannerSecretArn"
