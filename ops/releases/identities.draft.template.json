{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PREPARATION ONLY - three release roles + three attached managed-policy boundaries, no compute/Secret changes.",
  "Metadata": {
    "PreparationOnly": true,
    "TargetAccount": "402010193138",
    "TargetRegion": "ca-central-1",
    "TargetStackName": "techlong-sandbox-instance-release-identities-v1",
    "RequiredCapabilities": [
      "CAPABILITY_NAMED_IAM"
    ],
    "ExistingOidcProviderOnly": true,
    "SameManagedPolicyAttachedAsIdentityAndBoundary": true
  },
  "Parameters": {
    "ReadStackArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact current tenant + shared Cell + platform stack UUID ARNs; not historical IDs."
    },
    "ReleaseStackArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact existing tenant stack UUID ARN allowlist for Create/Execute; subset of ReadStackArns."
    },
    "EcsServiceArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact existing tenant service ARNs."
    },
    "EcsClusterArn": {
      "Type": "String",
      "Description": "Exact shared cluster ARN for ECS ListTasks/DescribeTasks conditions."
    },
    "EcsTaskArnPattern": {
      "Type": "String",
      "Description": "Exact cluster-qualified task ARN prefix with final /* for tasks replaced during release."
    },
    "DatabaseArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact approved database cluster and/or instance ARNs; describe only."
    },
    "ApplicationSecretArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact application/runtime Secret ARNs, metadata only; no value access."
    },
    "EcrRepositoryArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact existing API ECR repository ARNs; manifest read only."
    },
    "HostedZoneArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact existing public hosted-zone ARN; no DNS writes."
    },
    "UploadBucketArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact existing persistent upload bucket ARNs. ListBucket required for HeadBucket; no object value access."
    },
    "SecretsManagerKeyArn": {
      "Type": "String",
      "Description": "Verified exact AWS-managed aws/secretsmanager KMS key ARN in ca-central-1; do not create or change a key."
    },
    "PlannerSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ca-central-1:402010193138:secret:techlong/sandbox/instance-release/planner-db-v1-[A-Za-z0-9]{6}",
      "Description": "Full ARN returned by the separately approved Secret stack; do not synthesize suffix."
    },
    "PlannerSecretVersionId": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9-]{32,64}",
      "Description": "Exact nonsecret immutable VersionId observed after creation; no AWSCURRENT fallback."
    },
    "ExecutorSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ca-central-1:402010193138:secret:techlong/sandbox/instance-release/executor-db-v1-[A-Za-z0-9]{6}",
      "Description": "Full ARN returned by the separately approved Secret stack; do not synthesize suffix."
    },
    "ExecutorSecretVersionId": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9-]{32,64}",
      "Description": "Exact nonsecret immutable VersionId observed after creation; no AWSCURRENT fallback."
    },
    "VerifierSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ca-central-1:402010193138:secret:techlong/sandbox/instance-release/verifier-db-v1-[A-Za-z0-9]{6}",
      "Description": "Full ARN returned by the separately approved Secret stack; do not synthesize suffix."
    },
    "VerifierSecretVersionId": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9-]{32,64}",
      "Description": "Exact nonsecret immutable VersionId observed after creation; no AWSCURRENT fallback."
    }
  },
