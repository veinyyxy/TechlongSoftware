{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PREPARATION ONLY - publisher DB and exact-backend Actions-read token Secrets. No values supplied; no IAM/compute.",
  "Metadata": {
    "PreparationOnly": true,
    "TargetAccount": "402010193138",
    "TargetRegion": "ca-central-1",
    "TargetStackName": "techlong-sandbox-instance-release-promotion-secrets-v1",
    "CredentialValuesMustNotEnterRepository": true
  },
  "Parameters": {
    "PublisherSecretJson": {
      "Type": "String", "NoEcho": true, "MinLength": 1, "MaxLength": 4096,
      "Description": "Only connectionString for deployment_release_publisher_login/neondb/verify-full; supplied in memory after exact approval."
    },
    "BackendBuildTokenJson": {
      "Type": "String", "NoEcho": true, "MinLength": 1, "MaxLength": 4096,
      "Description": "Only token: user-approved non-expired read credential for veinyyxy/SpeedFeast_Backend_main Actions artifacts. No repository writes or environment approval. Do not use a short-lived expired installation token."
    }
  },
  "Resources": {
    "PublisherSecret": {
      "Type": "AWS::SecretsManager::Secret", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "techlong/sandbox/instance-release/publisher-db-v1",
        "SecretString": { "Ref": "PublisherSecretJson" },
        "Tags": [{ "Key": "Project", "Value": "Techlong" }, { "Key": "Environment", "Value": "sandbox" }, { "Key": "Purpose", "Value": "instance-release" }]
      }
    },
    "BackendBuildTokenSecret": {
      "Type": "AWS::SecretsManager::Secret", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "techlong/sandbox/instance-release/backend-build-read-token-v1",
        "SecretString": { "Ref": "BackendBuildTokenJson" },
        "Tags": [{ "Key": "Project", "Value": "Techlong" }, { "Key": "Environment", "Value": "sandbox" }, { "Key": "Purpose", "Value": "instance-release" }]
      }
    }
  },
  "Outputs": {
    "PublisherSecretArn": { "Value": { "Ref": "PublisherSecret" } },
    "BackendBuildTokenSecretArn": { "Value": { "Ref": "BackendBuildTokenSecret" } }
  }
}
