# Public branding
NEXT_PUBLIC_PLATFORM_NAME=餐饮 SaaS 平台

# Neon PostgreSQL pooled connection. Keep this server-only.
DATABASE_URL=postgresql://app_user:replace_me@example-pooler.neon.tech/neondb?sslmode=require

# App-owned login sessions remain valid for 1-30 days. Defaults to 7.
AUTH_SESSION_DAYS=7

# Stripe server-only secrets. Use Stripe test-mode keys locally and configure
# production values in the target host. Never expose or commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# AWS Sandbox deployment worker. Every execution gate defaults closed. Setting
# only AWS_APPLY_ENABLED=true is insufficient; the database environment,
# allowlisted assumed role, confirmation phrase, cleanup guardrail, parameters,
# STS identity, tenant database and mTLS control boundaries must all pass.
# Never add AWS access keys to this file or the repository.
# `techlong-sandbox-user` is only the source profile; the worker profile must
# assume AWS_SANDBOX_EXECUTION_ROLE_ARN; direct IAM-user credentials fail STS gate.
AWS_PROFILE=techlong-sandbox-provisioner
AWS_DEPLOYMENT_ENVIRONMENT_KEY=aws-sandbox-ca-central-1
AWS_SANDBOX_ACCOUNT_ID=402010193138
AWS_REGION=ca-central-1
AWS_DEFAULT_CELL_KEY=cell-sandbox-1
DEPLOYMENT_WORKER_ENABLED=false
AWS_APPLY_ENABLED=false
AWS_SANDBOX_EXECUTION_ROLE_ARN=arn:aws:iam::402010193138:role/TechlongSandboxProvisionerRole
AWS_SANDBOX_EXECUTION_CONFIRMATION=
DEPLOYMENT_WORKER_LEASE_MS=120000
DEPLOYMENT_WORKER_POLL_MS=10000
AWS_SANDBOX_BUDGET_LIMIT_USD=10
AWS_SANDBOX_TTL_SECONDS=7200
AWS_SANDBOX_MAX_CELLS=1
AWS_SANDBOX_MAX_TENANTS=1
AWS_SANDBOX_ALLOWED_PROFILES=standard-v1
AWS_SANDBOX_BASE_DOMAIN=sandbox.techlong.cloud
# A real S3 apply must pin an ECR digest; mutable tags such as `latest` are rejected.
AWS_SANDBOX_IMAGE_URI=402010193138.dkr.ecr.ca-central-1.amazonaws.com/techlong-sandbox-speedfeast@sha256:replace_with_64_hex_chars
