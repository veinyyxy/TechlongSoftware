# Public branding
NEXT_PUBLIC_PLATFORM_NAME=餐饮 SaaS 平台

# Comma-separated allowlist. Matching users become platform administrators
# after signing in. Keep this server-only and configure the production value
# through Sites rather than committing real addresses here.
PLATFORM_ADMIN_EMAILS=owner@example.com

# Neon PostgreSQL pooled connection. Keep this server-only.
DATABASE_URL=postgresql://app_user:replace_me@example-pooler.neon.tech/neondb?sslmode=require

# Stripe server-only secrets. Use Stripe test-mode keys locally and configure
# production values in Sites. Never expose or commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
