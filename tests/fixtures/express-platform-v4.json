      "configuration_schema": "{\"schemaVersion\":2,\"contract\":\"speedfeast-saas-control-v1\",\"fields\":[{\"key\":\"buyerAccountsMax\",\"label\":\"注册买家账号上限\",\"type\":\"integer\",\"source\":\"plan\",\"required\":false,\"min\":0,\"nullable\":true,\"nullLabel\":\"不限\",\"group\":\"套餐容量\",\"description\":\"允许注册的买家账号数量；选择“不限”时发送 null。\",\"unit\":\"个\",\"outputPath\":\"/entitlements/buyer.accounts.max\"},{\"key\":\"buyerConcurrentAccessMax\",\"label\":\"买家同时在线设备上限\",\"type\":\"integer\",\"source\":\"plan\",\"required\":true,\"min\":0,\"nullable\":true,\"nullLabel\":\"不限\",\"group\":\"套餐容量\",\"description\":\"允许同时保持活跃访问租约的买家设备数量。\",\"unit\":\"台\",\"outputPath\":\"/entitlements/buyer.concurrent_access.max\"},{\"key\":\"storesMax\",\"label\":\"门店上限\",\"type\":\"integer\",\"source\":\"plan\",\"required\":true,\"min\":1,\"nullable\":true,\"nullLabel\":\"不限\",\"group\":\"套餐容量\",\"description\":\"允许启用的门店数量，包含主店。\",\"unit\":\"家\",\"outputPath\":\"/entitlements/stores.max\"},{\"key\":\"merchantActiveUsersMax\",\"label\":\"商户用户账号上限（含管理员）\",\"type\":\"integer\",\"source\":\"plan\",\"required\":true,\"min\":1,\"nullable\":true,\"nullLabel\":\"不限\",\"group\":\"套餐容量\",\"description\":\"允许启用的商户端员工账号数量。\",\"unit\":\"个\",\"outputPath\":\"/entitlements/merchant.active_users.max\"},{\"key\":\"brandingCustomThemeEnabled\",\"label\":\"启用自定义主题\",\"type\":\"boolean\",\"source\":\"plan\",\"required\":true,\"group\":\"品牌能力\",\"description\":\"关闭后主题参数仍可保存，但订单系统运行时使用系统默认主题。\",\"outputPath\":\"/entitlements/branding.custom_theme.enabled\"},{\"key\":\"brandingMerchantEditable\",\"label\":\"允许商户修改品牌设置\",\"type\":\"boolean\",\"source\":\"plan\",\"required\":true,\"group\":\"品牌能力\",\"description\":\"控制商户是否可以自行修改店名和主题。\",\"outputPath\":\"/entitlements/branding.merchant_editable\"},{\"key\":\"buyerAccessLeaseSeconds\",\"label\":\"买家访问租约时长\",\"type\":\"integer\",\"source\":\"plan\",\"required\":true,\"min\":60,\"max\":86400,\"group\":\"访问策略\",\"description\":\"买家设备一次访问租约的有效时间。\",\"unit\":\"秒\",\"outputP